# PostgreSQL connection string (Supabase PostgreSQL URI or another PostgreSQL URL).
# Replace every placeholder. URL-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a unique value with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_unique_random_secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=false
ENVIRONMENT=development
